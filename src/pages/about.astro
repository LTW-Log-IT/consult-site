---
import Base from '../layouts/Base.astro';
import FounderBlock from '../components/FounderBlock.astro';
import CageLine from '../components/CageLine.astro';
---
<Base title="About" description="Lead the Way Logistics & IT is a Killeen, Texas small business offering BD support to small businesses entering or growing in federal and defense contracting.">
  <section class="bg-gunmetal text-paper">
    <div class="wrap py-16">
      <p class="eyebrow text-brass">About</p>
      <h1 class="mt-3 max-w-4xl">Lead the Way Logistics &amp; IT.</h1>
      <p class="mt-5 max-w-3xl text-lg text-[#d6d6d6]">A Killeen, Texas small business offering BD support to small businesses entering or growing in federal and defense contracting.</p>
    </div>
  </section>
  <section class="py-16">
    <div class="wrap grid gap-10 md:grid-cols-2">
      <div>
        <p class="eyebrow text-field">Why we do this</p>
        <h2 class="mt-2">Small businesses rarely have a full-time BD team.</h2>
      </div>
      <div class="space-y-4">
        <p>Most small businesses run business development on the side, between delivering for current customers and keeping the company running. Every hour spent on a bid that was never a good fit is an hour taken from delivery.</p>
        <p>We provide the structure a dedicated BD team would bring: deciding what to pursue, positioning early, finding the right partners, and building responses around what the customer asked for. Your team keeps the tools and templates we build together.</p>
      </div>
    </div>
  </section>
  <FounderBlock heading="Founder experience" />
  <section class="bg-band py-16">
    <div class="wrap">
      <p class="eyebrow text-field">Company facts</p>
      <p class="mt-3 text-lg font-semibold">Lead the Way Logistics &amp; IT LLC · Killeen, Texas · UEI MDDEPUWZFCW3 · CAGE pending</p>
      <CageLine class="mt-3 max-w-3xl" />
      <a href="/contact/" class="btn mt-8">Tell us where you are</a>
    </div>
  </section>
</Base>
