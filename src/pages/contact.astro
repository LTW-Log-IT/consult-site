---
import Base from '../layouts/Base.astro';
import CageLine from '../components/CageLine.astro';
import { engagements } from '../data';
const email = 'jbonilla@leadthewaylogistics.info';
const setAsides = ['Full & open', 'SB', '8(a)', 'HUBZone', 'SDVOSB', 'WOSB', 'Other/Unknown'];
---
<Base title="Contact" description="Bid decision intake for defense and federal small businesses. Tell us about the opportunity.">
  <section class="bg-gunmetal text-paper">
    <div class="wrap py-16">
      <p class="eyebrow text-brass">Contact</p>
      <h1 class="mt-3 max-w-4xl">Start a bid decision.</h1>
      <p class="mt-5 max-w-3xl text-lg text-[#d6d6d6]">This is a qualification intake, not a general inbox. Tell us about the opportunity and we will reply about fit and next steps.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="wrap grid gap-12 lg:grid-cols-[2fr_1fr]">
      <form id="intake" class="space-y-5" action={`mailto:${email}?subject=${encodeURIComponent('Bid decision intake')}`} method="post" enctype="text/plain">
        <p class="border-l-4 border-brass bg-band p-4 font-semibold">We run a conflict check before accepting proposal support.</p>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field"><label for="f-name">Your name</label><input id="f-name" name="Your name" autocomplete="name" required /></div>
          <div class="field"><label for="f-company">Company</label><input id="f-company" name="Company" autocomplete="organization" required /></div>
          <div class="field"><label for="f-email">Your email</label><input id="f-email" name="Your email" type="email" autocomplete="email" required /></div>
          <div class="field"><label for="f-entity">Pursuing entity (company bidding)</label><input id="f-entity" name="Pursuing entity" /></div>
          <div class="field"><label for="f-agency">Customer / agency</label><input id="f-agency" name="Customer / agency" /></div>
          <div class="field"><label for="f-vehicle">Contract vehicle</label><input id="f-vehicle" name="Contract vehicle" placeholder="or &quot;open market / unknown&quot;" /></div>
          <div class="field">
            <label for="f-setaside">Set-aside</label>
            <select id="f-setaside" name="Set-aside">
              <option value="">Select</option>
              {setAsides.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
          <div class="field"><label for="f-due">RFP / response due date</label><input id="f-due" name="RFP / response due date" type="date" /></div>
        </div>
        <fieldset class="field">
          <legend class="font-bold mb-2">Prime or sub intent</legend>
          <div class="flex flex-wrap gap-6">
            {['Prime', 'Sub', 'Undecided'].map((v) => (
              <label class="inline-flex items-center gap-2 font-normal"><input type="radio" name="Prime or sub intent" value={v} class="w-auto" /> {v}</label>
            ))}
          </div>
        </fieldset>
        <div class="field">
          <label for="f-engagement">Engagement interest</label>
          <select id="f-engagement" name="Engagement interest">
            <option value="">Select</option>
            {engagements.map((e) => <option value={e.name}>{e.name}</option>)}
          </select>
        </div>
        <div class="field"><label for="f-notes">Notes</label><textarea id="f-notes" name="Notes" rows="6"></textarea></div>
        <div>
          <button type="submit" class="btn cursor-pointer">Open email to send</button>
          <p class="mt-3 muted text-[0.9375rem]">Submitting opens your email app with these details filled in. Nothing is sent or stored by this site.</p>
        </div>
      </form>

      <aside class="space-y-6">
        <div class="card">
          <h2 class="text-xl">Prefer plain email?</h2>
          <p class="mt-2"><a href={`mailto:${email}?subject=${encodeURIComponent('Bid decision intake')}`} class="font-bold text-contrast underline decoration-brass decoration-2 break-all">{email}</a></p>
        </div>
        <div class="card">
          <h2 class="text-xl">CAGE status</h2>
          <CageLine class="mt-2" />
        </div>
      </aside>
    </div>
  </section>

  <script define:vars={{ email }}>
    const form = document.getElementById('intake');
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      const lines = [];
      for (const [k, v] of data.entries()) lines.push(`${k}: ${String(v).trim() || '-'}`);
      if (!data.has('Prime or sub intent')) lines.splice(8, 0, 'Prime or sub intent: -');
      const company = String(data.get('Company') || '').trim();
      const subject = `Bid decision intake${company ? ' - ' + company : ''}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  </script>
</Base>
