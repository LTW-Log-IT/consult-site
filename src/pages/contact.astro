---
import Base from '../layouts/Base.astro';
import CageLine from '../components/CageLine.astro';
import { services } from '../data';
const email = 'jbonilla@leadthewaylogistics.info';
const setAsides = ['Full & open', 'SB', '8(a)', 'HUBZone', 'SDVOSB', 'WOSB', 'Other/Unknown'];
const stages = ['New to federal contracting', 'Registered, not yet bidding', 'Bidding, want better results', 'Teaming or moving to prime', 'Other'];
const helpLabels: Record<string, string> = { 'rfi-sources-sought': 'RFI / sources-sought response', 'capability-statements': 'Capability statement' };
const helpOrder = ['opportunity-identification', 'bid-no-bid', 'capture', 'teaming', 'proposal-development', 'proposal-review', 'rfi-sources-sought', 'capability-statements', 'marketing-materials', 'bd-system', 'registration-readiness'];
const help = helpOrder.map((id) => services.find((s) => s.id === id)).filter((s) => s !== undefined).map((s) => helpLabels[s.id] ?? s.name);
const subjectFallback = 'BD intake';
---
<Base title="Contact" description="A short BD intake for small businesses in federal and defense contracting. Tell us where you are.">
  <section class="bg-gunmetal text-paper">
    <div class="wrap py-16">
      <p class="eyebrow text-brass">Contact</p>
      <h1 class="mt-3 max-w-4xl">Tell us where you are.</h1>
      <p class="mt-5 max-w-3xl text-lg text-[#d6d6d6]">This is a short intake so we can reply with a useful first step. We run a conflict check before accepting proposal support.</p>
    </div>
  </section>

  <section class="py-16">
    <div class="wrap grid gap-12 lg:grid-cols-[2fr_1fr]">
      <form id="intake" class="space-y-6" action={`mailto:${email}?subject=${encodeURIComponent(subjectFallback)}`} method="post" enctype="text/plain" novalidate>
        <div class="grid gap-5 sm:grid-cols-2">
          <div class="field"><label for="f-name">Your name <span aria-hidden="true">*</span></label><input id="f-name" name="Your name" autocomplete="name" required /></div>
          <div class="field"><label for="f-company">Company <span aria-hidden="true">*</span></label><input id="f-company" name="Company" autocomplete="organization" required /></div>
          <div class="field"><label for="f-email">Your email <span aria-hidden="true">*</span></label><input id="f-email" name="Your email" type="email" autocomplete="email" required /></div>
          <div class="field">
            <label for="f-where">Where you are now</label>
            <select id="f-where" name="Where you are now">
              <option value="">Select</option>
              {stages.map((s) => <option value={s}>{s}</option>)}
            </select>
          </div>
        </div>
        <fieldset>
          <legend class="font-bold mb-2">What you need help with</legend>
          <div class="grid gap-2 sm:grid-cols-2">
            {help.map((h, i) => (
              <label for={`f-help-${i}`} class="inline-flex items-start gap-2"><input id={`f-help-${i}`} type="checkbox" name="What you need help with" value={h} class="mt-1.5 h-4 w-4 accent-[#111111]" /> <span>{h}</span></label>
            ))}
          </div>
        </fieldset>
        <fieldset class="border-t border-[#dcdcd8] pt-6">
          <legend class="font-heading font-bold text-xl">If you have a specific opportunity (optional)</legend>
          <div class="mt-4 grid gap-5 sm:grid-cols-2">
            <div class="field"><label for="f-entity">Pursuing entity (company bidding)</label><input id="f-entity" name="Pursuing entity" /></div>
            <div class="field"><label for="f-agency">Customer / agency</label><input id="f-agency" name="Customer / agency" /></div>
            <div class="field"><label for="f-vehicle">Contract vehicle</label><input id="f-vehicle" name="Contract vehicle" placeholder="or &quot;open market / unknown&quot;" /></div>
            <div class="field">
              <label for="f-setaside">Set-aside</label>
              <select id="f-setaside" name="Set-aside">
                <option value="">Select</option>
                {setAsides.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div class="field"><label for="f-due">RFP / response due date</label><input id="f-due" name="RFP / response due date" type="date" /></div>
            <fieldset class="field">
              <legend class="font-bold mb-2">Prime or sub intent</legend>
              <div class="flex flex-wrap gap-6">
                {['Prime', 'Sub', 'Undecided'].map((v) => (
                  <label for={`f-ps-${v}`} class="inline-flex items-center gap-2 !font-normal"><input id={`f-ps-${v}`} type="radio" name="Prime or sub intent" value={v} class="!w-auto" /> {v}</label>
                ))}
              </div>
            </fieldset>
          </div>
        </fieldset>
        <div class="field"><label for="f-notes">Notes</label><textarea id="f-notes" name="Notes" rows="6"></textarea></div>
        <p id="form-error" class="hidden text-crimson font-semibold" role="alert"></p>
        <div>
          <button type="submit" class="btn cursor-pointer">Open email to send</button>
          <p class="mt-3 muted text-[0.9375rem]">Submitting opens your email app with these details filled in. Nothing is sent or stored by this site.</p>
        </div>
      </form>

      <aside class="space-y-6">
        <div class="card">
          <h2 class="text-xl">Prefer plain email?</h2>
          <p class="mt-2"><a href={`mailto:${email}?subject=${encodeURIComponent(subjectFallback)}`} class="font-bold text-contrast underline decoration-brass decoration-2 break-all">{email}</a></p>
        </div>
        <div class="card">
          <h2 class="text-xl">CAGE status</h2>
          <CageLine class="mt-2" />
        </div>
      </aside>
    </div>
  </section>

  <script define:vars={{ email }}>
    const form = document.getElementById('intake');
    const err = document.getElementById('form-error');
    const order = ['Your name', 'Company', 'Your email', 'Where you are now', 'What you need help with', 'Pursuing entity', 'Customer / agency', 'Contract vehicle', 'Set-aside', 'RFP / response due date', 'Prime or sub intent', 'Notes'];
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const invalid = Array.from(form.querySelectorAll('[required]')).find((el) => !el.checkValidity());
      if (invalid) {
        err.textContent = 'Please fill in your name, company, and a valid email.';
        err.classList.remove('hidden');
        invalid.focus();
        return;
      }
      err.classList.add('hidden');
      const data = new FormData(form);
      const lines = order.map((k) => {
        const vals = data.getAll(k).map((v) => String(v).trim()).filter(Boolean);
        return `${k}: ${vals.length ? vals.join(', ') : '-'}`;
      });
      const company = String(data.get('Company') || '').trim();
      const subject = `BD intake: ${company}`;
      window.location.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(lines.join('\n'))}`;
    });
  </script>
</Base>
