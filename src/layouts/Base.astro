---
import '../styles/global.css';
import CageLine from '../components/CageLine.astro';

interface Props { title: string; description: string; internal?: boolean; }
const { title, description, internal = false } = Astro.props;
const fullTitle = internal
  ? `Internal: ${title === 'Home' ? 'BD method library' : title} | Lead the Way Logistics & IT`
  : title === 'Home'
    ? 'Lead the Way Logistics & IT | BD Consulting'
    : `${title} | Lead the Way Logistics & IT BD Consulting`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const norm = (p: string) => (p.endsWith('/') ? p : p + '/');
const path = norm(Astro.url.pathname);
const publicNav = [
  { href: '/services/', label: 'Services' },
  { href: '/process/', label: 'Process' },
  { href: '/about/', label: 'About' },
  { href: '/firewall/', label: 'Firewall' },
  { href: '/contact/', label: 'Contact' },
];
const internalNav = [
  { href: '/internal/', label: 'Internal home' },
  { href: '/internal/method/', label: 'Method' },
  { href: '/internal/engagements/', label: 'Engagements' },
  { href: '/internal/proof/', label: 'Proof' },
  { href: '/internal/firewall/', label: 'Firewall' },
];
const nav = internal ? internalNav : publicNav;
const navLinkClass = (href: string) => ['font-heading font-semibold no-underline hover:text-brass', path === href ? 'text-brass' : 'text-paper'];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {internal ? (
      <>
        <meta name="robots" content="noindex, nofollow, noarchive" />
        <meta name="googlebot" content="noindex, nofollow" />
      </>
    ) : (
      <>
        <link rel="canonical" href={canonical} />
        <meta property="og:title" content={fullTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonical} />
      </>
    )}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700;800&family=IBM+Plex+Mono:wght@500&family=Manrope:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 bg-brass px-3 py-2">Skip to content</a>
    {internal && (
      <div class="bg-brass text-contrast text-center text-[0.9375rem] font-semibold py-1.5 px-4">Internal reference: LTW BD method and engagement library. Not linked from the public site.</div>
    )}
    <header class="bg-gunmetal text-paper">
      <div class="wrap flex items-center justify-between gap-4 py-4">
        <a href={internal ? '/internal/' : '/'} class="no-underline text-paper leading-tight">
          <span class="block font-heading text-xl font-extrabold">Lead the Way Logistics &amp; IT</span>
          <span class="eyebrow text-brass">BD Consulting</span>
        </a>
        <nav aria-label="Primary" class="hidden lg:flex items-center gap-x-5">
          {nav.map((n) => (
            <a href={n.href} class:list={navLinkClass(n.href)} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
          ))}
          {internal ? (
            <a href="/" class="eyebrow text-[#e0e0e0] no-underline hover:text-brass border border-[#777] px-2 py-1">Public site</a>
          ) : (
            <>
              <a href="https://leadthewaylogistics.info/" class="eyebrow text-[#e0e0e0] no-underline hover:text-brass border border-[#777] px-2 py-1">Main site</a>
              <a href="/contact/" class="btn !py-2 !px-4">Get started</a>
            </>
          )}
        </nav>
        <details class="lg:hidden relative">
          <summary class="cursor-pointer list-none font-heading font-bold border border-[#777] px-3 py-2 [&::-webkit-details-marker]:hidden">Menu</summary>
          <nav aria-label="Primary mobile" class="absolute right-0 z-20 mt-2 w-60 bg-gunmetal border border-[#444] p-4 flex flex-col gap-3">
            {nav.map((n) => (
              <a href={n.href} class:list={navLinkClass(n.href)} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a>
            ))}
            {internal ? (
              <a href="/" class="text-[#e0e0e0] hover:text-brass">Public site</a>
            ) : (
              <>
                <a href="https://leadthewaylogistics.info/" class="text-[#e0e0e0] hover:text-brass">Main site</a>
                <a href="/contact/" class="btn text-center">Get started</a>
              </>
            )}
          </nav>
        </details>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="bg-gunmetal text-[#d6d6d6]">
      <div class="wrap py-10 text-[0.9375rem]">
        <p class="text-paper font-semibold">Lead the Way Logistics &amp; IT LLC · Killeen, Texas · UEI MDDEPUWZFCW3 · CAGE pending</p>
        <CageLine class="mt-3 max-w-3xl" />
        <nav aria-label="Footer" class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          {publicNav.map((n) => <a href={n.href} class="text-[#e0e0e0] hover:text-brass">{n.label}</a>)}
        </nav>
        <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
          <a href="https://leadthewaylogistics.info/" class="text-brass">Main site: leadthewaylogistics.info</a>
          <a href="mailto:jbonilla@leadthewaylogistics.info" class="text-brass">jbonilla@leadthewaylogistics.info</a>
        </p>
      </div>
    </footer>
  </body>
</html>
